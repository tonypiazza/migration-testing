# Amazon OpenSearch Service (managed) target. No Kubernetes involved.
# All values are optional; the defaults create a 3-node, single-AZ, public-endpoint domain.

# name_prefix              = "os-tony"
# opensearch_version       = "3.5"              # major.minor only (engine_version = OpenSearch_3.5)
# region                   = "us-east-2"
# instance_type            = "r6g.large.search"
# node_count               = 3                  # must be a multiple of availability_zone_count
# availability_zone_count  = 1                  # 1 = zone awareness off; 2 or 3 spreads nodes across AZs
# disk_size_gb             = 80
# dedicated_master_enabled = false
# master_user_name         = "admin"
# allowed_cidrs            = ["203.0.113.0/24"] # public domains only

# Private networking (enabled via cluster.sh --private-networking):
# Places the domain inside a VPC with no public endpoint and authorizes the listed AWS
# accounts to create OpenSearch-managed VPC endpoints (PrivateLink) against it. After
# apply, hand the domain_arn output (printed by cluster.sh as "PSC URI") to the migration
# consumer, which creates an aws_opensearch_vpc_endpoint in its own VPC from that ARN.
# enable_psc                   = true
# privatelink_allowed_accounts = ["123456789012"]

# VPC Peering:
# Peers the domain's VPC with the migration cluster's VPC so the domain endpoint resolves
# and is reachable over internal IPs. After apply, the migration side must accept the
# peering (peering_connection_id output) and add reciprocal routes. peer_cidrs must not
# overlap with vpc_cidr (10.0.0.0/16 by default).
# vpc_peering = {
#   mode          = "enabled"
#   peer_owner_id = "123456789012"
#   peer_vpc_id   = "vpc-0abc123"
#   peer_region   = "us-east-2"
#   peer_cidrs    = ["10.20.0.0/16"]
# }
